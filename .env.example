# --- LLM: pick ONE. Provider is auto-detected; LLM_PROVIDER overrides. ---
# Use a key that belongs to you.
#
# 1) Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_BASE_URL=          # only for a non-standard endpoint
#
# 2) OpenAI (or any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=             # Together, Groq, OpenRouter, Ollama, ...
#
# 3) Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
#
# LLM_PROVIDER=                # anthropic | openai | azure
LLM_MODEL=claude-sonnet-5
# Must cover thinking budget + answer when extended thinking is on.
LLM_MAX_TOKENS=12000      # model id, or Azure deployment name

# Outreach sender. Use a dedicated domain, not your primary inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Rudrabha Chakraborty
FROM_EMAIL=
REPLY_TO=

# Safety rails
AUTO_SEND=false
MAX_EMAILS_PER_DAY=20
MAX_TAILORED_PER_DAY=200

# --- India coverage: free aggregator APIs ---
# Adzuna  -> https://developer.adzuna.com  (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble  -> https://jooble.org/api/about  (free key on request)
JOOBLE_API_KEY=
# Careerjet -> https://www.careerjet.com/partners/api/  (free affiliate id)
CAREERJET_AFFID=

# --- LinkedIn / Naukri / foundit via YOUR OWN alert emails (IMAP) ---
# Gmail needs an App Password (2FA on), not your login password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# --- Automated application filling ---
# prepare = fill + screenshot, never submit (default, recommended)
# confirm = submit only jobs you marked 'approved' in the dashboard
# auto    = fill + submit unattended. ATS terms prohibit this and they run
#           bot detection; a flag follows your email across every company
#           using that ATS.
APPLY_MODE=prepare
