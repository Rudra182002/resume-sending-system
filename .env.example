# Personal Anthropic key from console.anthropic.com  (NEVER a work/gateway key)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-5

# Outreach sender. Use a dedicated domain, not your primary inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Rudrabha Chakraborty
FROM_EMAIL=
REPLY_TO=

# Safety rails
AUTO_SEND=false
MAX_EMAILS_PER_DAY=20
MAX_TAILORED_PER_DAY=200

# --- India coverage: free aggregator APIs ---
# Adzuna  -> https://developer.adzuna.com  (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble  -> https://jooble.org/api/about  (free key on request)
JOOBLE_API_KEY=
# Careerjet -> https://www.careerjet.com/partners/api/  (free affiliate id)
CAREERJET_AFFID=

# --- LinkedIn / Naukri / foundit via YOUR OWN alert emails (IMAP) ---
# Gmail needs an App Password (2FA on), not your login password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
